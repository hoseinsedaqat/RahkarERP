# ============================================================
#  راهکار — نمونه‌ی تنظیمات محیطی
#  این فایل را با نام «.env» کپی کنید و مقادیر را تغییر دهید.
#  فایل .env هرگز در مخزن کد قرار نمی‌گیرد.
# ============================================================

# پورتی که سرور روی آن گوش می‌دهد (فرانت‌اند ساخته‌شده + API روی همین پورت)
PORT=8080

# حالت اجرا: production باعث سخت‌گیری‌های امنیتی بیشتر می‌شود.
# اگر production بگذارید، JWT_SECRET زیر «حتماً» باید حداقل ۳۲ کاراکتر باشد.
NODE_ENV=production

# کلید امضای توکن نشست (حداقل ۳۲ کاراکتر). برای ساخت یک کلید تصادفی:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# اگر خالی بماند، برنامه خودش یک کلید تصادفیِ پایدار در پوشه‌ی .data می‌سازد.
JWT_SECRET=

# پوشه‌ی ذخیره‌ی داده‌ها (پایگاه فایل، نشست‌ها، پشتیبان‌ها). پیش‌فرض: .data کنارِ پروژه
# DATA_DIR=.data

# نام و کد سازمان پیش‌فرض (فقط در نخستین اجرا استفاده می‌شود)
# ORGANIZATION_NAME=گروه صنعتی آریا
# ORGANIZATION_CODE=ARIA

# اتصال به PostgreSQL (اختیاری؛ در نبود آن، داده‌ها در فایل .data/store.json ذخیره می‌شوند)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/aria

# مبدأهای مجاز CORS (فقط اگر فرانت‌اند روی دامنه‌ی دیگری است؛ با ویرگول جدا کنید)
# CORS_ORIGIN=https://erp.example.com

# پشت پروکسی معکوس با HTTPS (nginx/IIS) این را true کنید تا هدر HSTS فرستاده شود
# TRUST_PROXY=true

# پشتیبان‌گیری خودکار: هر چند ساعت یک‌بار و چند نسخه نگه داشته شود (۰ = غیرفعال)
# BACKUP_INTERVAL_HOURS=12
# BACKUP_KEEP=14
# BACKUP_DIR=.data/backups

# ورود با گوگل (اختیاری)
# GOOGLE_CLIENT_ID=
# GOOGLE_ALLOWED_DOMAINS=example.com
# GOOGLE_DEFAULT_ROLE=viewer
# GOOGLE_AUTO_SIGNUP=false

# Supabase (اختیاری)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
