{
  "name": "erp-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:server\" \"npm:client\"",
    "build": "tsc --noEmit && vite build",
    "server": "tsx server/index.ts",
    "client": "vite",
    "serve": "tsx server/index.ts",
    "start": "node scripts/start-server.mjs",
    "preview": "vite preview",
    "migrate": "tsx server/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && vitest run tests/unit && node tests/e2e/run.mjs",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "node tests/e2e/run.mjs",
    "docker:build": "docker build -t aria-erp:latest .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "package:win": "node scripts/build-windows-package.mjs",
    "build:demo": "tsc --noEmit && cross-env VITE_DEMO=true BASE_PATH=./ vite build && node scripts/prepare-pages.mjs",
    "build:demo:local": "cross-env VITE_DEMO=true BASE_PATH=./ vite build --outDir dist-demo && node scripts/prepare-pages.mjs dist-demo",
    "code:collect": "node scripts/collect-code.mjs"
  },
  "dependencies": {
    "pg": "^8.23.0",
    "tsx": "^4.23.12"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "concurrently": "^9.2.4",
    "cross-env": "^7.0.3",
    "jsdom": "^26.1.0",
    "pg-mem": "^3.0.14",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
